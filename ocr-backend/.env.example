# ─────────────────────────────────────────────────────────────────────────────
# ocr-backend/ -- Keppler OCR API + Celery worker (core/config.py).
#
# Copy to ocr-backend/.env when running the API on the host, or with
# ocr-backend/docker-compose.yml (it mounts this folder into the container,
# and the settings class reads .env from there). Values set in the compose
# file's `environment:` win over this file.
#
# Not used by backend/docker-compose.yml or deploy/ -- those pass their own
# values (OCR_JWT_SECRET_KEY / OCR_UPLOAD_ENCRYPTION_KEY in backend/.env,
# OCR_JWT_SECRET / OCR_UPLOAD_ENCRYPTION_KEY in deploy/.env).
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Keppler Medical Document Intelligence Platform"
APP_VERSION="2.0.0"

# vLLM (OpenAI-compatible) server, with /v1. Local GPU box: host port 8700.
VLLM_BASE_URL="http://localhost:8700/v1"
QWEN_OCR_MODEL="qwen2.5-vl-7b"

# Model router (per-role model ids)
VISION_MODEL="qwen2.5-vl-7b"
SUMMARY_MODEL="qwen2.5-vl-7b"
CHAT_MODEL="qwen2.5-vl-7b"
ENTITY_MODEL="qwen2.5-vl-7b"
EMBEDDING_MODEL="BAAI/bge-m3"
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# Vector database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="keppler_documents"

# Redis + Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# PostgreSQL (host port 5433 = ocr-backend/docker-compose.yml's postgres)
DATABASE_URL="postgresql+psycopg://keppler:keppler@localhost:5433/keppler"

# ── Secrets ──────────────────────────────────────────────────────────────────
# Empty = public dev defaults from core/config.py: fine on a laptop, never on a
# shared or production server.
# JWT signing key:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Fernet key that encrypts uploads at rest. Losing it makes uploads unreadable.
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
UPLOAD_ENCRYPTION_KEY=
# After rotating UPLOAD_ENCRYPTION_KEY, list the old key(s) here (comma-separated)
# so files written under them stay readable. The dev default is always readable.
UPLOAD_ENCRYPTION_PREVIOUS_KEYS=
