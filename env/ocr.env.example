# hms-ocr-api, hms-ocr-worker, hms-ocr-migrate (database: HMS OCR)
DATABASE_URL=<postgresql+psycopg://user:pass@host:5432/keppler>
REDIS_URL=<redis://host:6379/0>
CELERY_BROKER_URL=<redis://host:6379/0>
CELERY_RESULT_BACKEND=<redis://host:6379/0>
CELERY_CONCURRENCY=2
QDRANT_URL=<http://host:6333>
QDRANT_COLLECTION=keppler_documents
CORS_ALLOWED_ORIGINS=
# vLLM server, with /v1
VLLM_BASE_URL=http://<host>:8700/v1
QWEN_OCR_MODEL=qwen3-vl-8b
VISION_MODEL=qwen3-vl-8b
SUMMARY_MODEL=qwen3-vl-8b
CHAT_MODEL=qwen3-vl-8b
ENTITY_MODEL=qwen3-vl-8b
# Loaded inside the container from Hugging Face (ask-dev list)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Generated: never change after first start
JWT_SECRET_KEY=<generated>
UPLOAD_ENCRYPTION_KEY=<generated>
