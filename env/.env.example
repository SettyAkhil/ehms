# Compose-level settings (read by docker compose itself)
COMPOSE_PROJECT_NAME=ehms
EHMS_NETWORK=ehms-net
WEB_BIND_IP=<host>
WEB_PORT=<auto-port>
# Public address as the edge serves it, no trailing slash (also compiled into the web app)
PUBLIC_URL=<https://hms.example.com>
# Public Razorpay key id, compiled into the web app (empty = test key)
RAZORPAY_KEY_ID=
# Host folders (owned by the container uid, see ops notes)
UPLOADS_DIR=./storage/uploads
HR_DOCS_DIR=./storage/hr-docs
OCR_UPLOADS_DIR=./storage/ocr-uploads
HF_CACHE_DIR=./storage/hf-cache
WHISPER_CACHE_DIR=./storage/whisper-cache
