# The 9 hospital services + hms-celery-worker (database: HMS MAIN)
DATABASE_URL=<postgresql://user:pass@host:5432/hospai>
REDIS_URL=<redis://host:6379/0>
CELERY_BROKER_URL=<redis://host:6379/0>
# Workers per service / per-worker DB pool (9 services x 2 x 5 = 90 connections)
WEB_CONCURRENCY=2
PG_POOL_MIN=1
PG_POOL_MAX=5
CELERY_CONCURRENCY=2
# Sessions and CORS (empty CORS = same-origin only)
CORS_ALLOWED_ORIGINS=<same as PUBLIC_URL>
SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=<true when PUBLIC_URL is https>
SESSION_COOKIE_SAMESITE=Lax
SEED_DEMO_USERS=true
# Generated: never change after first start
SESSION_PEPPER=<generated>
SETTINGS_ENCRYPTION_KEY=<generated>
# vLLM chat server, with /v1
AI_PROVIDER=vllm
VLLM_BASE_URL=http://<host>:8700/v1
VLLM_API_KEY=local
VLLM_MODEL=qwen3-vl-8b
VLLM_TIMEOUT_SECONDS=300
# Embedding server, with /v1
VLLM_EMBEDDING_URL=http://<host>:8701/v1
VLLM_EMBEDDING_MODEL=qwen3-embedding-0.6b
RAG_EMBEDDING_DIM=1024
# Whisper runs inside hms-ai on CPU (ask-dev list)
WHISPER_MODEL_SIZE=small
# Patient links and messages
PUBLIC_BASE_URL=<https://hms.example.com/hms-api>
PATIENT_DOCUMENT_LINK_TTL_HOURS=168
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TEMPLATE_SIDS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
