# hms-hr-api, hms-hr-worker (database: HMS HR)
# Daily login: the restricted hr_app role
HR_DATABASE_URL=<postgresql+psycopg://hr_app:pass@host:5432/hospai_hr>
# Owner login: startup migrations only
HR_DATABASE_OWNER_URL=<postgresql+psycopg://hr_owner:pass@host:5432/hospai_hr>
# Password of the hr_app role (same as in HR_DATABASE_URL), set at the DB stage
HR_APP_DB_PASSWORD=<hr_app password>
REDIS_URL=<redis://host:6379/2>
CELERY_CONCURRENCY=2
HR_AUTH_SERVICE_URL=http://auth-service:8011
HR_GATEWAY_URL=http://gateway:8010
HR_DOCUMENT_ROOT=/data/hr-documents
HR_TIMEZONE=Asia/Kolkata
# Must equal SESSION_COOKIE_NAME in backend.env
SESSION_COOKIE_NAME=hospai_session
FORWARDED_ALLOW_IPS=*
HR_SECRETS_KEY=<generated>
