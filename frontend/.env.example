# ─────────────────────────────────────────────────────────────────────────────
# frontend/ -- the hospital web app (Vite). Copy to frontend/.env only if you
# need to change a default; every value here is optional.
#
# VITE_* values are compiled INTO the browser bundle at build time: anyone can
# read them. Never put a secret here.
#
# Not read from this file (set them in the shell instead):
#   PORT=8443          dev / preview server port            (vite.config.ts)
#   HRMS_PORT, PG*     legacy Node HRMS server, see frontend/server/db/index.mjs
#                      (defaults match ocr-backend/docker-compose.yml's
#                      hrms-postgres on 127.0.0.1:5434)
# ─────────────────────────────────────────────────────────────────────────────

# Backend base URL. Default "/hms-api" (same origin, proxied to the gateway on
# :8010 by vite.config.ts in dev and by nginx in production). Set it only for a
# build whose backend lives elsewhere, e.g. the Cloudflare Pages deploy
# (frontend/.env.production).
# VITE_API_BASE=https://your-backend-tunnel.example.com

# Public address patients' phones open from the OP-card QR code and SMS links.
# Default: the page origin, or this machine's LAN address when that is localhost.
# VITE_PUBLIC_APP_URL=https://hms.yourhospital.in

# Embedded Keppler OCR app. Default "/keppler-ocr/" (proxied to ocr-frontend :3000).
# VITE_DPI_OCR_URL=/keppler-ocr/

# Razorpay PUBLIC key id for pharmacy card/UPI checkout. Default: a test key.
# VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Browser-side LLM calls (src/lib/llm.ts). Defaults: "/vllm-api/v1/chat/completions"
# (proxied to the vLLM server), API key "local", model auto-discovered.
# VITE_QWEN_API_URL=/vllm-api/v1/chat/completions
# VITE_QWEN_API_KEY=local
# VITE_QWEN_MODEL=qwen3-vl-8b
