 },
 "item": [
  {
   "name": "Health",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "X-CSRF-Token",
      "value": "{{csrf}}"
     }
    ],
    "url": {
     "raw": "{{base}}/api/v1/hr/health",
     "host": [
      "{{base}}"
     ],
     "path": [
      "api",
      "v1",
      "hr",
      "health"
     ],
     "query": []
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "exec": [
       "pm.test(\"healthy\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
      ]
     }
    }
   ]
  },
  {
