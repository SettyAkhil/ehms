# ─────────────────────────────────────────────────────────────────────────────
# backend/ -- development stack (backend/docker-compose.yml): the 9 Flask
# services, the gateway, hr-api + hr-worker, and the merged Keppler OCR
# services. Copy to backend/.env and fill in. .env is gitignored -- never
# commit real credentials.
#
# docker compose reads this file for ${VAR} substitution; only variables that
# docker-compose.yml lists under a service's `environment:` reach containers.
# Production does not use this file: see deploy/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Port when one service runs on the host (python services/<name>/app.py).
PORT=8010
# Browser origins allowed to call the gateway (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:8443

# ── Main hospital database (PostgreSQL 16) ──────────────────────────────────
# Not started by this compose file: it is an existing container joined over
# the external "testhospai_default" network (see README.md -> Databases).
# DATABASE_URL        = from the host (python services/<name>/app.py)
# DATABASE_URL_DOCKER = the same database by its Docker DNS name (compose)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:9103/DBNAME
DATABASE_URL_DOCKER=postgresql://USER:PASSWORD@testhospai_postgres:5432/DBNAME

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=12
# Random secret mixed into session hashes:  openssl rand -base64 32
SESSION_PEPPER=change-me-to-a-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Seed the demo accounts the login screen's role picker uses (admin, doctor,
# staff, employee). true for a fresh dev database.
SEED_DEMO_USERS=false

# ── AI model server (vLLM, OpenAI-compatible) ───────────────────────────────
AI_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:8700/v1
VLLM_BASE_URL_DOCKER=http://host.docker.internal:8700/v1
VLLM_MODEL=qwen3-vl-8b
VLLM_API_KEY=local

# ── Patient SMS / WhatsApp via Twilio (optional) ────────────────────────────
# Unset: every message is logged as "not_configured" and the desk gets a
# one-click manual hand-off. Can also be saved from the admin screen
# (encrypted with SETTINGS_ENCRYPTION_KEY).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled sender, without the "whatsapp:" prefix, e.g. +14155238886
TWILIO_WHATSAPP_FROM=
# Plain SMS sender number -- or, for India (DLT), a Messaging Service that
# carries the registered sender ID; the service SID wins when both are set.
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
SMS_DEFAULT_COUNTRY_CODE=+91
# Approved WhatsApp Content Templates per message kind (needed outside the
# 24-hour session window), e.g. {"bill":"HX...","feedback_request":"HX..."}.
# See backend/modules/messaging/routes.py for the template variables.
WHATSAPP_TEMPLATE_SIDS=
# Public HTTPS origin of this gateway. Needed to attach PDFs (Twilio fetches
# them over the internet), to put document links in SMS, and for delivery
# receipts / patient replies to reach us. Not localhost.
PUBLIC_BASE_URL=
PATIENT_DOCUMENT_LINK_TTL_HOURS=168
# Fernet key encrypting provider credentials saved from the admin screen:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# ── Card / UPI payments via Razorpay (optional) ─────────────────────────────
# Unset: payment routes answer "Razorpay is not configured" and signature
# checks fail closed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── HR & Workforce (hr-api, own database hr-postgres) ───────────────────────
# Owner runs migrations; hr_app is the non-superuser runtime role RLS applies
# to. HR_SECRETS_KEY is a Fernet key (command above) encrypting eSSL
# credentials at rest -- rotating it makes stored ones unreadable.
HR_OWNER_DB_PASSWORD=
HR_APP_DB_PASSWORD=
HR_SECRETS_KEY=
HR_TIMEZONE=Asia/Kolkata

# ── Keppler OCR (ocr-api / ocr-worker in this compose file) ─────────────────
# Empty = public dev defaults (ocr-backend/core/config.py). Set both on any
# shared machine. JWT key: openssl rand -base64 48 ; upload key: Fernet (above).
OCR_JWT_SECRET_KEY=
OCR_UPLOAD_ENCRYPTION_KEY=

# ── Read by the code, NOT passed by docker-compose.yml ──────────────────────
# Take effect when a service runs on the host, or after adding them to
# x-backend-env in docker-compose.yml.
# FLASK_ENV=development            # relaxed dev behaviour (app factory)
# DEFAULT_HOSPITAL_CODE=hosp-default
# PG_POOL_MIN=1
# PG_POOL_MAX=20
# RATELIMIT_DEFAULT=600 per minute # ";"-separated limits
# PLATFORM_ADMIN_USERNAME=         # platform super-admin login (shared/session_auth.py)
# PLATFORM_ADMIN_PASSWORD=
# ADMIN_ROUTE_PASSWORD=            # admin console password (core/auth.py)
# ADMIN_ROUTE_AUTH_SECRET=
# ADMIN_ROUTE_AUTH_TTL_SECONDS=
# BUCKET_NAME= / S3_BUCKET_NAME= / AWS_S3_BUCKET=   # object storage (core/storage.py);
# BUCKET_URL= S3_ENDPOINT_URL= S3_VIRTUAL_HOSTED=   # default is local disk
# AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_REGION=
# WHATSAPP_ACCESS_TOKEN= WHATSAPP_PHONE_ID=          # legacy Meta Cloud API module
# WHATSAPP_VERIFY_TOKEN=                             # webhook token; unset refuses verification
# WHISPER_MODEL_SIZE=large-v3 WHISPER_DEVICE= WHISPER_COMPUTE_TYPE= WHISPER_DEFAULT_LANGUAGE=
# VLLM_TIMEOUT_SECONDS= VLLM_EMBEDDING_MODEL=nomic-embed-text RAG_EMBEDDING_DIM=768
# CELERY_TASK_ALWAYS_EAGER=false
