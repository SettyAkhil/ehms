# ─────────────────────────────────────────────────────────────────────────────
# EHMS deployment settings for docker-compose.yml.
#
#   cp .env.example .env
#   ./deploy/init-env.sh        # fills every empty secret below, once
#
# Keep .env private (chmod 600) and BACK IT UP: losing the encryption keys makes
# stored data unreadable. Never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# Public address users open in the browser (scheme + host [+ port], no slash).
# Used for CORS, cookie scope and the patient-card QR links.
PUBLIC_URL=https://hms.example-hospital.in

# true when users reach the site over HTTPS (TLS terminated in front of `web`).
# Set false ONLY for a plain-http trial on a private network: browsers refuse
# Secure cookies over http, so login would silently fail.
SESSION_COOKIE_SECURE=true

# Where the web container listens on the host.
WEB_BIND=0.0.0.0
WEB_PORT=80

TZ=Asia/Kolkata
DEFAULT_HOSPITAL_CODE=hosp-default
SESSION_TTL_HOURS=12

# ── First System Administrator ──────────────────────────────────────────────
# Used ONLY when the database has no `admin` account yet (first start).
# Sign in as `admin` with this password, then change it in Administration.
INITIAL_ADMIN_PASSWORD=

# ── Database / cache passwords (generated) ─────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
HMS_DB_PASSWORD=
HRMS_DB_PASSWORD=
HR_OWNER_DB_PASSWORD=
HR_APP_DB_PASSWORD=
OCR_DB_PASSWORD=
REDIS_PASSWORD=

# ── Application secrets (generated; never change after first start) ────────
# hex: session token pepper
SESSION_PEPPER=
# Fernet: encrypts integration credentials stored in the main DB
SETTINGS_ENCRYPTION_KEY=
# Fernet: encrypts biometric-device credentials in the HR DB
HR_SECRETS_KEY=
# OCR profile only
OCR_JWT_SECRET_KEY=
OCR_UPLOAD_ENCRYPTION_KEY=

# ── AI servers (optional; OpenAI-compatible, e.g. vLLM on the LAN) ─────────
# Leave empty to run without AI features.
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
VLLM_EMBEDDING_URL=
VLLM_EMBEDDING_MODEL=
RAG_EMBEDDING_DIM=1024
# Browser-side LLM calls (/vllm-api) are proxied here, e.g. http://10.0.0.5:8700
VLLM_UPSTREAM=

# ── Messaging & payments (optional) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

HR_CELERY_CONCURRENCY=2
