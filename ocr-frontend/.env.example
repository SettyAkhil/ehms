# ─────────────────────────────────────────────────────────────────────────────
# ocr-frontend/ -- the embedded Keppler OCR app (Vite). Optional: copy to
# ocr-frontend/.env only to change the default. Compiled into the browser
# bundle -- never put a secret here.
# ─────────────────────────────────────────────────────────────────────────────

# OCR API base. Default "/api/v1": same origin, proxied to ocr-backend :7620 by
# this app's vite.config.ts in dev and by nginx (deploy/web) in production.
# VITE_API_BASE_URL=/api/v1
