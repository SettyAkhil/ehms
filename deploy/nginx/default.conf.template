# EHMS public web server. Mirrors the dev proxy table in frontend/vite.config.ts:
#
#   /                      hospital web app (static, SPA)
#   /keppler-ocr/          Keppler OCR UI (static, SPA)            [profile ocr]
#   /hms-api/api/hr/*      legacy Node HRMS  (hrms:8011)
#   /iclock/*              eSSL biometric push -> Node HRMS
#   /hms-api/api/v1/<hr>   HR & Workforce API (hr-api:8020)
#   /hms-api/*             hospital backend   (backend:8010)
#   /api/*                 Keppler OCR API    (ocr-api:7620)       [profile ocr]
#   /vllm-api/*            browser LLM calls  ($VLLM_UPSTREAM, optional)
#
# Upstreams are resolved per request through Docker's DNS, so nginx starts even
# when an optional service is not running (those paths then return 502).

resolver 127.0.0.11 valid=30s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    proxy_read_timeout 300s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 300s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    set $backend_upstream backend:8010;
    set $hrms_upstream    hrms:8011;
    set $hrapi_upstream   hr-api:8020;
    set $ocr_upstream     ocr-api:7620;
    set $vllm_upstream    "${VLLM_UPSTREAM}";

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # ── Legacy Node HRMS ────────────────────────────────────────────────
    location ^~ /hms-api/api/hr/events {
        rewrite ^/hms-api(/.*)$ $1 break;
        proxy_pass http://$hrms_upstream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    location ^~ /hms-api/api/hr {
        rewrite ^/hms-api(/.*)$ $1 break;
        proxy_pass http://$hrms_upstream;
    }
    location ^~ /iclock {
        proxy_pass http://$hrms_upstream;
    }

    # ── HR & Workforce API (hr-api) ─────────────────────────────────────
    location ~ ^/hms-api/api/v1/attendance/live/stream$ {
        rewrite ^/hms-api(/.*)$ $1 break;
        proxy_pass http://$hrapi_upstream;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    location ~ ^/hms-api/api/v1/(hr|attendance|workforce|payroll|recruitment|onboarding|training|performance|compliance|me|reports/hr|facility|team)(/|$) {
        rewrite ^/hms-api(/.*)$ $1 break;
        proxy_pass http://$hrapi_upstream;
    }

    # ── Hospital backend (everything else under /hms-api) ───────────────
    # Plain prefix (no ^~) on purpose: the hr-api regex locations above must
    # still be able to win for /hms-api/api/v1/<hr paths>.
    location /hms-api/ {
        rewrite ^/hms-api(/.*)$ $1 break;
        proxy_pass http://$backend_upstream;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # ── Keppler OCR ─────────────────────────────────────────────────────
    location ^~ /api/ {
        proxy_pass http://$ocr_upstream;
    }
    location ^~ /keppler-ocr/ {
        alias /usr/share/nginx/keppler-ocr/;
        try_files $uri $uri/ /keppler-ocr/index.html;
    }

    # ── Browser LLM calls (optional) ────────────────────────────────────
    location ^~ /vllm-api/ {
        if ($vllm_upstream = "") {
            return 503 '{"error":"AI server not configured (VLLM_UPSTREAM)"}';
        }
        rewrite ^/vllm-api(/.*)$ $1 break;
        proxy_pass $vllm_upstream;
        proxy_read_timeout 600s;
    }

    # ── Hospital web app ────────────────────────────────────────────────
    root /usr/share/nginx/html;

    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
